# ============================================================
# Lumina RAG — Free Stack Environment Template
# ============================================================
# Copy this file to `backend/.env` and fill in the secrets you want.
#
# REQUIRED for the demo to work end-to-end:
#   - GEMINI_API_KEY      (Google AI Studio — free tier)
#   - QDRANT_URL          (Qdrant Cloud free tier, or local Docker)
#
# OPTIONAL (graceful degradation when unset):
#   - SUPABASE_URL + SUPABASE_SERVICE_KEY
#       When empty, SupabaseService runs in local mode — no metadata
#       persistence, but chat/ingest still work. Set these to enable
#       document registry + chat history persistence.
#   - GROQ_API_KEY         (Whisper audio transcription — only needed
#       if you upload audio files. PDF/DOCX/PPTX/TXT don't need it.)
#
# Everything else has safe defaults. See "App settings" at the bottom
# for tunable knobs.

# ============================================================
# REQUIRED: LLM (Google Gemini 2.0 Flash — free tier)
# ============================================================
# Get your key at https://aistudio.google.com/apikey
# Free tier: 15 RPM, 1M TPM, 1500 RPD. Plenty for demos.
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEXT_MODEL=gemini-2.0-flash-lite

# ============================================================
# REQUIRED: Vector store (Qdrant — free tier or local Docker)
# ============================================================
# Option A — Qdrant Cloud free tier (1 GB free):
#   Sign up at https://cloud.qdrant.io, create a free cluster,
#   copy the URL and API key from the dashboard.
#
# Option B — Local Docker (recommended for dev):
#   docker run -p 6333:6333 -p 6334:6334 \
#     -v qdrant_data:/qdrant/storage qdrant/qdrant:latest
#
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=multimodal_rag

# ============================================================
# OPTIONAL: Supabase (Postgres + Storage) — free tier
# ============================================================
# When BOTH URL and SERVICE_KEY are set, document registry, chat
# history, and session metadata persist in Supabase. When empty,
# SupabaseService degrades to local mode (in-memory; session UUIDs
# are still issued by the SessionIsolationMiddleware).
#
# Get free credentials at https://supabase.com (free tier: 500 MB
# Postgres, 1 GB storage, 50k MAU).
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGc...   (service_role key, NOT anon)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ============================================================
# OPTIONAL: Audio transcription (Groq Whisper Large V3 — free)
# ============================================================
# Only needed if you upload audio/video files. PDF/DOCX/PPTX/TXT
# ingestion works without it. Free tier: ~7k tokens/min.
# Get your key at https://console.groq.com.
#
# GROQ_API_KEY=gsk_...
GROQ_API_KEY=

# ============================================================
# Local models (no API keys — runs on CPU)
# ============================================================
# These download once on first run (~400 MB embedder, ~30 MB reranker)
# and are cached locally.
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
RERANK_MODEL=ms-marco-MiniLM-L-12-v2

# ============================================================
# App settings
# ============================================================
CORS_ORIGINS=http://localhost:3000
MAX_RETRIEVAL_RETRIES=3
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
RELEVANCE_THRESHOLD=0.5

# ============================================================
# Session isolation (per-tenant multi-user support)
# ============================================================
SESSION_HEADER=X-Session-ID
SESSION_AUTO_ISSUE=true
